{
  "name": "ai-blog-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack MERN blog platform with AI-assisted draft generation.",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "dev:client": "npm run dev --prefix client",
    "install:client": "npm install --prefix client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "engines": {
    "node": ">=18"
  }
}
